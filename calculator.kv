#:kivy 2.2.0
#:import dp kivy.metrics.dp

<CalcButton@Button>:
    font_size: dp(24)
    background_normal: ''
    background_color: 0.18, 0.20, 0.25, 1
    color: 1, 1, 1, 1
    size_hint: 1, 1
    # Визуальный отклик при нажатии
    background_down: ''
    background_color_down: 0.35, 0.40, 0.50, 1

<CalcButtonOperator@CalcButton>:
    background_color: 0.20, 0.35, 0.55, 1
    background_color_down: 0.30, 0.50, 0.70, 1

<CalcButtonAction@CalcButton>:
    background_color: 0.65, 0.25, 0.20, 1
    background_color_down: 0.85, 0.35, 0.30, 1

<CalcButtonEquals@CalcButton>:
    background_color: 0.15, 0.55, 0.35, 1
    background_color_down: 0.25, 0.75, 0.50, 1
    font_size: dp(28)


<CalculatorLayout>:
    orientation: 'vertical'
    padding: dp(8)
    spacing: dp(6)

    # ── Дисплей ──────────────────────────────────────────
    BoxLayout:
        size_hint_y: 0.22
        canvas.before:
            Color:
                rgba: 0.10, 0.11, 0.14, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(10)]

        Label:
            id: display
            text: root.display_text
            font_size: dp(32)
            halign: 'right'
            valign: 'middle'
            text_size: self.width - dp(20), self.height
            color: 0.90, 0.92, 0.95, 1
            shorten: True
            shorten_from: 'left'

    # ── Сетка кнопок ─────────────────────────────────────
    GridLayout:
        cols: 4
        spacing: dp(6)
        size_hint_y: 0.78

        # Строка 1
        CalcButtonAction:
            text: 'C'
            on_press: root.clear_display()
        CalcButton:
            text: '⌫'
            on_press: root.backspace()
        CalcButton:
            text: '+/-'
            on_press: root.toggle_sign()
        CalcButtonOperator:
            text: '÷'
            on_press: root.append_operator('÷')

        # Строка 2
        CalcButton:
            text: '7'
            on_press: root.append_digit('7')
        CalcButton:
            text: '8'
            on_press: root.append_digit('8')
        CalcButton:
            text: '9'
            on_press: root.append_digit('9')
        CalcButtonOperator:
            text: '×'
            on_press: root.append_operator('×')

        # Строка 3
        CalcButton:
            text: '4'
            on_press: root.append_digit('4')
        CalcButton:
            text: '5'
            on_press: root.append_digit('5')
        CalcButton:
            text: '6'
            on_press: root.append_digit('6')
        CalcButtonOperator:
            text: '−'
            on_press: root.append_operator('-')

        # Строка 4
        CalcButton:
            text: '1'
            on_press: root.append_digit('1')
        CalcButton:
            text: '2'
            on_press: root.append_digit('2')
        CalcButton:
            text: '3'
            on_press: root.append_digit('3')
        CalcButtonOperator:
            text: '+'
            on_press: root.append_operator('+')

        # Строка 5
        CalcButton:
            text: '%'
            on_press: root.append_operator('%')
        CalcButton:
            text: '0'
            on_press: root.append_digit('0')
        CalcButton:
            text: '.'
            on_press: root.append_digit('.')
        CalcButtonEquals:
            text: '='
            on_press: root.calculate_result()